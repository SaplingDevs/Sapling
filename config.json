{
	"$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/v1.4.json",
	"author": "AlecsDeveloper",
	"name": "Sapling Addon",
	"packs": {
		"behaviorPack": "./source/resources/data",
		"resourcePack": "./source/resources/assets"
	},
	"regolith": {
		"dataPath": "./sources/javascript",
		"filterDefinitions": {
			"gametests": {
				"url": "github.com/Bedrock-OSS/regolith-filters",
				"version": "1.7.2"
			}
		},
		"formatVersion": "1.4.0",
		"profiles": {
			"default": {
				"export": {
					"build": "standard",
					"readOnly": false,
					"target": "development"
				},
				"filters": []
			}
		}
	}
}